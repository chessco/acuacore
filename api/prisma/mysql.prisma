generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  PRODUCER
  BIOLOGIST
  TECHNICAL_ADVISOR
  DIRECTOR
  ADMIN
  OPERATOR
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      Plan     @default(FREE)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  conversations Conversation[]
  skills        Skill[]
  agents        Agent[]
  knowledge     KnowledgeBase[]
  costLogs      AiCostLog[]
  corrections   HumanCorrection[]
  capsules      Capsule[]
  tenantFeatures TenantFeature[]
  campaigns     Campaign[]
}

model HumanCorrection {
  id        String   @id @default(uuid())
  tenantId  String
  trigger   String   @db.VarChar(255) // The user pattern to match
  response  String   @db.Text        // The verified human response
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  password  String?
  name      String
  role      Role
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant         @relation(fields: [tenantId], references: [id])
  conversations         Conversation[] @relation("ConversationOwner")
  assignedConversations Conversation[] @relation("AssignedTo")
}

model Conversation {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  assignedToId String?
  externalId   String? // WhatsApp ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  user       User      @relation("ConversationOwner", fields: [userId], references: [id])
  assignedTo User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  messages   Message[]
  leads      Lead[]
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  role           String // 'user' | 'assistant'
  content        String   @db.Text
  classification String?
  confidence     Float?
  isFlagged      Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  hitl         HitlAction?
}

model HitlAction {
  id         String   @id @default(uuid())
  messageId  String   @unique
  tenantId   String
  level      String // 'BIOLOGIST' | 'ADVISOR' | 'DIRECTOR'
  status     String // 'PENDING' | 'APPROVED' | 'REJECTED'
  reviewerId String?
  comments   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id])
}

enum SkillStatus {
  PRE_PRODUCTION
  PRODUCTION
  INACTIVE
}

model Skill {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  prompt      String   @db.Text
  version     String   @default("1.0")
  status      SkillStatus @default(PRE_PRODUCTION)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  promptVersions PromptVersion[]
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  tenantId  String? // Null for global knowledge
  title     String
  source    String?
  version   String   @default("1.0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  chunks KnowledgeBaseChunk[]
}

model KnowledgeBaseChunk {
  id        String   @id @default(uuid())
  kbId      String
  tenantId  String?
  content   String   @db.Text
  sequence  Int
  createdAt DateTime @default(now())

  kb KnowledgeBase @relation(fields: [kbId], references: [id])
}

model AiCostLog {
  id         String   @id @default(uuid())
  tenantId   String
  model      String
  tokensIn   Int
  tokensOut  Int
  costUsd    Float
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model PromptVersion {
  id        String   @id @default(uuid())
  skillId   String
  content   String   @db.Text
  version   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id])
}


model Agent {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String   @unique
  description String?
  prompt      String   @db.Text
  isActive    Boolean  @default(true)
  config      Json?
  version     String   @default("1.0")
  status      String   @default("PRE_PRODUCTION") // PRE_PRODUCTION, PRODUCTION
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  versions    AgentVersion[]
  capsules    Capsule[]
}

model AgentVersion {
  id        String   @id @default(uuid())
  agentId   String
  prompt    String   @db.Text
  version   String
  status    String   // PRE_PRODUCTION, PRODUCTION
  createdAt DateTime @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())
}

model Capsule {
  id            String   @id @default(uuid())
  tenantId      String?  // Nullable for global capsules
  agentId       String
  title         String
  slug          String   @unique
  description   String?  @db.Text
  topic         String
  status        String   @default("DRAFT") // DRAFT, PUBLISHED
  contentBlocks Json     // Array of blocks (hero, features, etc)
  knowledgeIds  Json?    // Optional specific KB IDs
  promptConfig  Json?    // Overrides for agent prompt
  ctaConfig     Json?    // Lead form config
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  agent  Agent   @relation(fields: [agentId], references: [id])
  leads  Lead[]
  campaigns Campaign[]
}

model Lead {
  id             String   @id @default(uuid())
  capsuleId      String
  conversationId String?
  name           String
  email          String
  phone          String?
  metadata       Json?
  createdAt      DateTime @default(now())

  capsule      Capsule       @relation(fields: [capsuleId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
}

model Feature {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "capsules"
  createdAt DateTime @default(now())

  tenantFeatures TenantFeature[]
}

model TenantFeature {
  id        String  @id @default(uuid())
  tenantId  String
  featureId String
  enabled   Boolean @default(false)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
}

model Campaign {
  id          String    @id @default(uuid())
  tenantId    String
  capsuleId   String
  name        String
  audience    String?   @db.Text
  subject     String
  content     String    @db.Text
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  capsule Capsule @relation(fields: [capsuleId], references: [id])
}
