generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String            @id @default(uuid())
  name           String
  plan           Plan              @default(FREE)
  status         Status            @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  brandingConfig Json?
  isDefault      Boolean           @default(false)
  agents         Agent[]
  costLogs       AiCostLog[]
  campaigns      Campaign[]
  capsules       Capsule[]
  conversations  Conversation[]
  corrections    HumanCorrection[]
  knowledge      KnowledgeBase[]
  skills         Skill[]
  tenantFeatures TenantFeature[]
  users          User[]
  leads          Lead[]
}

model HumanCorrection {
  id        String   @id @default(uuid())
  tenantId  String
  trigger   String   @db.VarChar(255)
  response  String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id                    String         @id @default(uuid())
  tenantId              String
  email                 String         @unique
  name                  String
  role                  User_role
  status                Status         @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  password              String?
  permissions           Json?
  assignedConversations Conversation[] @relation("AssignedTo")
  conversations         Conversation[] @relation("ConversationOwner")
  tenant                Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "User_tenantId_fkey")
}

model Conversation {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String?
  externalId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedToId String?
  source       String    @default("WHATSAPP")
  metadata     Json?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  user         User?     @relation("ConversationOwner", fields: [userId], references: [id])
  leads        Lead[]
  messages     Message[]

  @@index([assignedToId], map: "Conversation_assignedToId_fkey")
  @@index([tenantId], map: "Conversation_tenantId_fkey")
  @@index([userId], map: "Conversation_userId_fkey")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  tenantId       String
  role           String
  content        String       @db.Text
  classification String?
  confidence     Float?
  isFlagged      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  hitl           HitlAction?
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId], map: "Message_conversationId_fkey")
}

model HitlAction {
  id         String   @id @default(uuid())
  messageId  String   @unique
  tenantId   String
  level      String
  status     String
  reviewerId String?
  comments   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  message    Message  @relation(fields: [messageId], references: [id])
}

model Skill {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  prompt         String          @db.Text
  version        String          @default("1.0")
  config         Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  status         SkillStatus     @default(PRE_PRODUCTION)
  promptVersions PromptVersion[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "Skill_tenantId_fkey")
}

model KnowledgeBase {
  id        String               @id @default(uuid())
  tenantId  String?
  title     String
  source    String?
  version   String               @default("1.0")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  status    Status               @default(ACTIVE)
  tenant    Tenant?              @relation(fields: [tenantId], references: [id])
  chunks    KnowledgeBaseChunk[]

  @@index([tenantId], map: "KnowledgeBase_tenantId_fkey")
}

model KnowledgeBaseChunk {
  id        String        @id @default(uuid())
  kbId      String
  tenantId  String?
  content   String        @db.Text
  sequence  Int
  createdAt DateTime      @default(now())
  kb        KnowledgeBase @relation(fields: [kbId], references: [id])

  @@index([kbId], map: "KnowledgeBaseChunk_kbId_fkey")
}

model AiCostLog {
  id        String   @id @default(uuid())
  tenantId  String
  model     String
  tokensIn  Int
  tokensOut Int
  costUsd   Float
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "AiCostLog_tenantId_fkey")
}

model PromptVersion {
  id        String   @id @default(uuid())
  skillId   String
  content   String   @db.Text
  version   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@index([skillId], map: "PromptVersion_skillId_fkey")
}

model Agent {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  slug        String         @unique
  description String?
  prompt      String         @db.Text
  isActive    Boolean        @default(true)
  config      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  status      String         @default("PRE_PRODUCTION")
  version     String         @default("1.0")
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  versions    AgentVersion[]
  capsules    Capsule[]

  @@index([tenantId], map: "Agent_tenantId_fkey")
}

model AgentVersion {
  id        String   @id @default(uuid())
  agentId   String
  prompt    String   @db.Text
  version   String
  status    String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@index([agentId], map: "AgentVersion_agentId_fkey")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())
}

model Capsule {
  id            String     @id @default(uuid())
  tenantId      String?
  agentId       String
  title         String
  slug          String     @unique
  description   String?    @db.Text
  topic         String
  status        String     @default("DRAFT")
  contentBlocks Json
  knowledgeIds  Json?
  promptConfig  Json?
  ctaConfig     Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
  agent         Agent      @relation(fields: [agentId], references: [id])
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  leads         Lead[]

  @@index([agentId], map: "Capsule_agentId_fkey")
  @@index([tenantId], map: "Capsule_tenantId_fkey")
}

model Lead {
  id             String        @id @default(uuid())
  tenantId       String?
  capsuleId      String
  campaignId     String?
  conversationId String?
  name           String
  email          String
  phone          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  capsule        Capsule       @relation(fields: [capsuleId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([capsuleId], map: "Lead_capsuleId_fkey")
  @@index([conversationId], map: "Lead_conversationId_fkey")
  @@index([campaignId], map: "Lead_campaignId_fkey")
  @@index([tenantId])
}

model Feature {
  id             String          @id @default(uuid())
  name           String          @unique
  createdAt      DateTime        @default(now())
  tenantFeatures TenantFeature[]
}

model TenantFeature {
  id        String  @id @default(uuid())
  tenantId  String
  featureId String
  enabled   Boolean @default(false)
  feature   Feature @relation(fields: [featureId], references: [id])
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureId])
  @@index([featureId], map: "TenantFeature_featureId_fkey")
}

model Campaign {
  id             String          @id @default(uuid())
  tenantId       String
  capsuleId      String
  name           String
  audience       String?         @db.Text
  subject        String
  content        String          @db.Text
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  templateConfig Json?
  opensCount     Int             @default(0)
  clicksCount    Int             @default(0)
  capsule        Capsule         @relation(fields: [capsuleId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  leads          Lead[]
  events         CampaignEvent[]

  @@index([capsuleId], map: "Campaign_capsuleId_fkey")
  @@index([tenantId], map: "Campaign_tenantId_fkey")
}

model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  email      String?
  type       String   @default("OPEN") // "OPEN" or "CLICK"
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SkillStatus {
  PRE_PRODUCTION
  PRODUCTION
  INACTIVE
}

enum User_role {
  PRODUCER
  BIOLOGIST
  TECHNICAL_ADVISOR
  DIRECTOR
  ADMIN
  OPERATOR
  SYSTEM
}
